{
  "name": "golf-round-studio-local",
  "version": "0.1.2",
  "private": true,
  "description": "Golf Round Studio – lokale Desktop-App für Windows und macOS",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "electron .",
    "build": "vite build",
    "test": "vitest run && node --test tools/orchestrator.node-test.mjs tools/lockfile-security.node-test.mjs dist-electron/ipc-validation.node-test.mjs dist-electron/media-engine.node-test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "orchestrate": "node tools/orchestrator.mjs",
    "dist:mac:arm64": "npm run build && electron-builder --mac dmg zip --arm64",
    "pack:mac:arm64": "npm run build && electron-builder --mac dir --arm64"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "2.1.2",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "archiver": "^8.0.0",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.6"
  },
  "build": {
    "appId": "de.johannesstuck.golfroundstudio",
    "productName": "Golf Round Studio",
    "artifactName": "Golf-Round-Studio-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/@ffprobe-installer/**/*"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Golf Round Studio"
    }
  }
}
